{
  "extends": "../deepseek-harness/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "lib/types",
    "paths": {
      "cordis": ["../deepseek-harness/vendor/cordis/src"],
      "schemastery": ["../deepseek-harness/vendor/schemastery/src"],
      "@cordisjs/plugin-loader": ["../deepseek-harness/vendor/loader/src"],
      "@cordisjs/plugin-loader/repository": ["../deepseek-harness/vendor/loader/src/repository.ts"],
      "@deepseek-ai/dsh-cordis-fabric": ["src/index.ts"],
      "@deepseek-ai/dsh-cordis-fabric/src/*": ["src/*"],
      "@deepseek-ai/dsh-cordis-fabric/*": ["src/*"],
      "@deepseek-ai/dsh-cordis-fabric/api": ["src/api/index.ts"],
      "@deepseek-ai/dsh-cordis-fabric/api/*": ["src/api/*"],
      "@deepseek-ai/dsh-cordis-fabric/client": ["src/client/index.ts"],
      "@deepseek-ai/dsh-cordis-fabric/api/client": ["src/client/api.ts"],
      "@deepseek-ai/dsh-invariants": ["../deepseek-harness/packages/support/invariants/src/index.ts"],
      "@deepseek-ai/dsh-agent": ["../deepseek-harness/packages/core/agent/src"],
      "@deepseek-ai/dsh-session": ["../deepseek-harness/packages/core/session/src"],
      "@deepseek-ai/dsh-commands": ["../deepseek-harness/packages/interaction/commands/src"],
      "@deepseek-ai/dsh-system-prompt": ["../deepseek-harness/packages/core/system-prompt/src"],
      "@deepseek-ai/dsh-tools": ["../deepseek-harness/packages/core/tools/src"],
      "@deepseek-ai/dsh-client-ui-command": ["../deepseek-harness/packages/client/ui-command/src"],
      "@deepseek-ai/dsh-client-ui-command/client": ["../deepseek-harness/packages/client/ui-command/src/client/index.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["../deepseek-harness/packages/client/ui-slots/src"],
      "@deepseek-ai/dsh-client-ui-slash/client": ["../deepseek-harness/packages/client/ui-slash/src/client/index.ts"],
      "@deepseek-ai/dsh-client-runtime/client": ["../deepseek-harness/packages/client/runtime/src/client/index.ts"],
      "@deepseek-ai/dsh-host-webserver": ["../deepseek-harness/packages/host/webserver/src"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../deepseek-harness/vendor/cordis" },
    { "path": "../deepseek-harness/packages/support/invariants" },
    { "path": "../deepseek-harness/packages/core/agent" },
    { "path": "../deepseek-harness/packages/client/ui-command" },
    { "path": "../deepseek-harness/packages/client/ui-slots" },
    { "path": "../deepseek-harness/packages/interaction/commands" },
    { "path": "../deepseek-harness/packages/core/session" },
    { "path": "../deepseek-harness/packages/core/system-prompt" },
    { "path": "../deepseek-harness/packages/core/tools" }
  ]
}
