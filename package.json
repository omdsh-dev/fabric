{
  "name": "cordis-fabric-bundle",
  "description": "Fabric/Mixin extension workspace: installable profile bundle carrier over the cordis-fabric package trio",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "BSD-3-Clause",
  "files": [
    "lib/fabric-dsh.js",
    "lib/fabric-dsh.js.map",
    "lib/fabric-dsh-preload.js",
    "lib/fabric-dsh-preload.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter cordis-fabric run build && pnpm --filter cordis-fabric-api run build && pnpm --filter cordis-fabric-dsh run build && pnpm exec tsdown --config-loader unrun --config tsdown.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.vitest.json --pretty false"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "cordis-fabric": "https://github.com/omdsh-dev/fabric/releases/latest/download/cordis-fabric.tgz",
    "cordis-fabric-api": "https://github.com/omdsh-dev/fabric/releases/latest/download/cordis-fabric-api.tgz",
    "cordis-fabric-dsh": "https://github.com/omdsh-dev/fabric/releases/latest/download/cordis-fabric-dsh.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8",
    "unrun": "^0.3.1",
    "happy-dom": "^20.0.0"
  },
  "bundledDependencies": [
    "cordis-fabric",
    "cordis-fabric-api",
    "cordis-fabric-dsh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fabric-dsh": "lib/fabric-dsh.js"
  }
}
