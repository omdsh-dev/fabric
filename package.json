{
  "name": "@deepseek-ai/dsh-cordis-fabric",
  "description": "Fabric/Mixin extension bundle with cooperative Host and browser API faces",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/api.js"
    },
    "./api/agent": {
      "types": "./lib/types/api/agent.d.ts",
      "default": "./lib/api-agent.js"
    },
    "./api/tools": {
      "types": "./lib/types/api/tools.d.ts",
      "default": "./lib/api-tools.js"
    },
    "./api/prompt": {
      "types": "./lib/types/api/prompt.d.ts",
      "default": "./lib/api-prompt.js"
    },
    "./api/commands": {
      "types": "./lib/types/api/commands.d.ts",
      "default": "./lib/api-commands.js"
    },
    "./api/compat": {
      "types": "./lib/types/api/compat.d.ts",
      "default": "./lib/api-compat.js"
    },
    "./api/invariant": {
      "types": "./lib/types/api/invariant.d.ts",
      "default": "./lib/api-invariant.js"
    },
    "./api/client": {
      "types": "./lib/types/client/api.d.ts",
      "default": "./lib/api-client.js"
    },
    "./hook-entry": {
      "types": "./lib/types/hook-entry.d.ts",
      "default": "./lib/hook-entry.js"
    },
    "./testkit": {
      "types": "./lib/types/testkit.d.ts",
      "default": "./lib/testkit.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/api.js",
    "lib/api-agent.js",
    "lib/api-tools.js",
    "lib/api-prompt.js",
    "lib/api-commands.js",
    "lib/api-compat.js",
    "lib/api-invariant.js",
    "lib/api-client.js",
    "lib/hook-entry.js",
    "lib/testkit.js",
    "lib/testkit-runner.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.vitest.json --pretty false",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshClient": {
    "platform": "web",
    "inject": []
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@apm-js-collab/code-transformer": "^0.18.1",
    "module-details-from-path": "^1.0.4",
    "node-addon-require-builtin": "^0.1.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@cordisjs/plugin-loader": "^1.0.0-rc.5",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.20.0",
    "cordis": "^4.0.0-rc.7",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
