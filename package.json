{
  "name": "@oh-my-dsh/cordis-fabric-pack",
  "description": "Fabric/Mixin extension workspace: installable profile bundle carrier over the cordis-fabric package trio",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/fabric.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/fabric-dsh.js",
    "lib/fabric-dsh.js.map",
    "lib/fabric-dsh-preload.js",
    "lib/fabric-dsh-preload.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @oh-my-dsh/cordis-fabric run build && pnpm --filter @oh-my-dsh/cordis-fabric-api run build && pnpm --filter @oh-my-dsh/cordis-fabric-dsh run build && pnpm exec tsdown --config-loader unrun --config tsdown.config.ts",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@oh-my-dsh/cordis-fabric": "^0.1.1",
    "@oh-my-dsh/cordis-fabric-api": "^0.1.1",
    "@oh-my-dsh/cordis-fabric-dsh": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8",
    "unrun": "^0.3.1",
    "happy-dom": "^20.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "bin": {
    "fabric-dsh": "lib/fabric-dsh.js"
  }
}
