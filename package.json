{
  "name": "cordis-fabric-bundle",
  "description": "Fabric/Mixin extension workspace: installable profile bundle carrier over the cordis-fabric package trio",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "BSD-3-Clause",
  "files": [
    "scripts",
    "lib/fabric-dsh.js",
    "lib/fabric-dsh.js.map",
    "cordis.patch.yml",
    "packages/cordis-fabric/package.json",
    "packages/cordis-fabric/preload.mjs",
    "packages/cordis-fabric/lib",
    "packages/cordis-fabric-api/package.json",
    "packages/cordis-fabric-api/lib",
    "packages/cordis-fabric-dsh/package.json",
    "packages/cordis-fabric-dsh/lib",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter cordis-fabric run build && pnpm --filter cordis-fabric-api run build && pnpm --filter cordis-fabric-dsh run build && pnpm exec tsdown --config-loader unrun --config tsdown.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.vitest.json --pretty false",
    "install:host": "bash scripts/install.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "cordis-fabric": "github:dsh-external/fabric#main&path:/packages/cordis-fabric",
    "cordis-fabric-api": "github:dsh-external/fabric#main&path:/packages/cordis-fabric-api",
    "cordis-fabric-dsh": "github:dsh-external/fabric#main&path:/packages/cordis-fabric-dsh"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8",
    "unrun": "^0.3.1",
    "happy-dom": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fabric-dsh": "lib/fabric-dsh.js"
  }
}
