index 0000000000000000000000000000000000000000..65278aaceb3b452180e0ee794302c17e827954a3
--- /dev/null
+++ b/apps/cli/tests/fabric-bootstrap.spec.ts
@@ -0,0 +1,47 @@
+import { beforeEach, describe, expect, it } from 'vitest'
+import { installFabricBootstrap } from '../src/app-cli-entry.ts'
+import { GLOBAL_BRIDGE_KEY } from '@deepseek-ai/dsh-cordis-fabric/src/bridge.ts'
+
+const stub = {
+  id: 'launcher/before-add',
+  target: {
+    module: 'fabric-target-fixture',
+    versionRange: '^1.0.0',
+    filePath: 'index.mjs',
+    functionQuery: { functionName: 'add', kind: 'Sync' },
+  },
+  operation: 'before',
+}
+
+describe('installFabricBootstrap', () => {
+  beforeEach(() => {
+    Reflect.deleteProperty(globalThis, GLOBAL_BRIDGE_KEY)
+  })
+
+  it('installs the Fabric hooks when the cordis-fabric row carries patches', async () => {
+    await installFabricBootstrap([
+      { id: 'cordis-fabric', name: '@deepseek-ai/dsh-cordis-fabric', config: { patches: [stub] } },
+    ])
+    expect((globalThis as Record<string, unknown>)[GLOBAL_BRIDGE_KEY]).toHaveProperty('publish')
+  })
+
+  it('installs nothing when the row is absent', async () => {
+    await installFabricBootstrap([{ id: 'other', name: '@deepseek-ai/dsh-other' }])
+    expect((globalThis as Record<string, unknown>)[GLOBAL_BRIDGE_KEY]).toBeUndefined()
+  })
+
+  it('installs nothing when the row has no patches', async () => {
+    await installFabricBootstrap([{ id: 'cordis-fabric', name: '@deepseek-ai/dsh-cordis-fabric', disabled: true }])
+    expect((globalThis as Record<string, unknown>)[GLOBAL_BRIDGE_KEY]).toBeUndefined()
+  })
+
+  it('fails loud on a malformed patch from configuration', async () => {
+    await expect(installFabricBootstrap([
+      {
+        id: 'cordis-fabric',
+        name: '@deepseek-ai/dsh-cordis-fabric',
+        config: { patches: [{ ...stub, target: { ...stub.target, module: '' } }] },
+      },
+    ])).rejects.toThrow(/module/)
+  })
+})
