{
  "name": "cordis-fabric-api",
  "description": "Cooperative Fabric API: the pure-Cordis compat facade over the cordis-fabric registry",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compat/service": {
      "types": "./lib/compat/service.d.ts",
      "default": "./lib/compat/service.js"
    },
    "./compat/instrumentation": {
      "types": "./lib/compat/instrumentation.d.ts",
      "default": "./lib/compat/instrumentation.js"
    },
    "./compat/types": {
      "types": "./lib/compat/types.d.ts",
      "default": "./lib/compat/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/compat/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "prepare": "tsdown --config-loader unrun --config tsdown.config.ts"
  },
  "peerDependencies": {
    "cordis-fabric": "^0.1.0",
    "@deepseek-ai/cordis": "^4.0.1-0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "cordis-fabric": "workspace:^",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "^4.0.1-0"
  },
  "publishConfig": {
    "access": "public"
  }
}
