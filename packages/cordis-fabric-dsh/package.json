{
  "name": "cordis-fabric-dsh",
  "description": "DSH integrations for the Cordis Fabric layer: DSH-facing facades, the package invariant, and the DSH profile bootstrap that composes the pure fabric hooks",
  "version": "0.0.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host/agent": {
      "types": "./lib/types/host/agent.d.ts",
      "default": "./lib/host/agent.js"
    },
    "./host/tools": {
      "types": "./lib/types/host/tools.d.ts",
      "default": "./lib/host/tools.js"
    },
    "./host/prompt": {
      "types": "./lib/types/host/prompt.d.ts",
      "default": "./lib/host/prompt.js"
    },
    "./host/commands": {
      "types": "./lib/types/host/commands.d.ts",
      "default": "./lib/host/commands.js"
    },
    "./bootstrap/profile": {
      "types": "./lib/types/bootstrap/profile.d.ts",
      "default": "./lib/bootstrap/profile.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./browser/client": {
      "types": "./lib/types/browser/client/index.d.ts",
      "default": "./lib/browser/client.js"
    },
    "./client": {
      "types": "./lib/types/browser/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/host/*.js",
    "lib/bootstrap/*.js",
    "lib/browser/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map"
  ],
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -b && tsdown --config-loader unrun --config tsdown.config.ts",
    "typecheck": "tsc --pretty false",
    "prepare": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -b && tsdown --config-loader unrun --config tsdown.config.ts"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0",
    "cordis-fabric": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0",
    "cordis-fabric": "workspace:^",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
