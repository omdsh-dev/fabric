{
  "name": "cordis-fabric",
  "description": "Fabric/Mixin-style extension layer over Orchestrion for trusted Cordis plugins",
  "version": "0.0.1-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./hook-entry": {
      "types": "./lib/types/hook-entry.d.ts",
      "default": "./lib/hook-entry.js"
    },
    "./testkit": {
      "types": "./lib/types/testkit.d.ts",
      "default": "./lib/testkit.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/hook-entry.js",
    "lib/testkit.js",
    "lib/testkit-runner.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsc -b && tsdown --config tsdown.config.ts",
    "typecheck": "tsc --pretty false"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@apm-js-collab/code-transformer": "^0.18.1",
    "module-details-from-path": "^1.0.4",
    "node-addon-require-builtin": "^0.1.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@cordisjs/plugin-hmr": "^1.0.15",
    "@cordisjs/plugin-include": "^1.0.4",
    "@cordisjs/plugin-loader": "^1.0.0-rc.5",
    "@cordisjs/plugin-timer": "^1.1.2",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.20.0",
    "cordis": "^4.0.0-rc.7",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
