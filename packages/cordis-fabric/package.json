{
  "name": "cordis-fabric",
  "description": "Fabric/Mixin-style extension layer over Orchestrion for trusted Cordis plugins",
  "version": "0.0.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node/loader": {
      "types": "./lib/types/node/loader.d.ts",
      "default": "./lib/node/loader.js"
    },
    "./node/hook-entry": {
      "types": "./lib/types/node/hook-entry.d.ts",
      "default": "./lib/node/hook-entry.js"
    },
    "./node/identity": {
      "types": "./lib/types/node/identity.d.ts",
      "default": "./lib/node/identity.js"
    },
    "./node/wire": {
      "types": "./lib/types/node/wire.d.ts",
      "default": "./lib/node/wire.js"
    },
    "./browser/client": {
      "types": "./lib/types/browser/client/index.d.ts",
      "default": "./lib/browser/client.js"
    },
    "./browser/transform": {
      "types": "./lib/types/browser/transform.d.ts",
      "default": "./lib/browser/transform.js"
    },
    "./browser/serve": {
      "types": "./lib/types/browser/serve.d.ts",
      "default": "./lib/browser/serve.js"
    },
    "./transform/config": {
      "types": "./lib/types/transform/config.d.ts",
      "default": "./lib/transform/config.js"
    },
    "./transform/transform": {
      "types": "./lib/types/transform/transform.d.ts",
      "default": "./lib/transform/transform.js"
    },
    "./hmr/ownership": {
      "types": "./lib/types/hmr/ownership.d.ts",
      "default": "./lib/hmr/ownership.js"
    },
    "./hmr/reload": {
      "types": "./lib/types/hmr/reload.d.ts",
      "default": "./lib/hmr/reload.js"
    },
    "./testing/testkit": {
      "types": "./lib/types/testing/testkit.d.ts",
      "default": "./lib/testing/testkit.js"
    },
    "./testing/testkit-runner": {
      "types": "./lib/types/testing/testkit-runner.d.ts",
      "default": "./lib/testing/testkit-runner.js"
    },
    "./client": {
      "types": "./lib/types/browser/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/node/*.js",
    "lib/browser/*.js",
    "lib/transform/*.js",
    "lib/hmr/*.js",
    "lib/testing/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "preload.mjs"
  ],
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -b && tsdown --config-loader unrun --config tsdown.config.ts",
    "typecheck": "tsc --pretty false",
    "prepare": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -b && tsdown --config-loader unrun --config tsdown.config.ts"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0"
  },
  "dependencies": {
    "@apm-js-collab/code-transformer": "^0.18.1",
    "module-details-from-path": "^1.0.4",
    "node-addon-require-builtin": "^0.1.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "^4.0.1-0",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
